# Copy to .env.multi-instance and replace every secret/example value.
# Never commit .env.multi-instance.

DATABASE_NAME=tallysync
DATABASE_USER=tallysync_app
DATABASE_PASSWORD=replace-with-strong-db-password

DATABASE_POOL_MAX=15
DATABASE_CONNECTION_BUDGET=80
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=15m
JWT_ISSUER=tallysync-api
JWT_AUDIENCE=tallysync-app
REFRESH_TOKEN_EXPIRES_DAYS=30

PLATFORM_ADMIN_EMAIL=owner@tallysync.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-new-strong-platform-owner-password

# Only required if running the normal production seed to create/reset admin@tallysync.com.
SEED_ADMIN_EMAIL=admin@tallysync.com
SEED_ADMIN_PASSWORD=replace-with-a-different-strong-seed-admin-password
SEED_RESET_ADMIN_PASSWORD=false

CORS_ORIGINS=http://localhost:5174
API_PORT=3000
ENABLE_SWAGGER=false
BODY_LIMIT=1mb
SLOW_REQUEST_MS=1500

# Only api-a runs background jobs until multi-worker job behavior is separately verified.
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_JOBS_POLL_INTERVAL_MS=5000
BACKGROUND_JOBS_BATCH_SIZE=10
BACKGROUND_JOBS_STALE_AFTER_SECONDS=900

# Container resource ceilings. Tune after observing real host metrics.
API_MEMORY_LIMIT=768m
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_CPU_LIMIT=1.0
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=0.5
MIGRATE_MEMORY_LIMIT=512m
MIGRATE_CPU_LIMIT=0.5

# Bounded Docker json-file logs.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=5
