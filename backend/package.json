{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "npx typeorm-ts-node-commonjs",
    "migration:show": "npx typeorm-ts-node-commonjs migration:show -d ./src/database/data-source.ts",
    "migration:run": "npx typeorm-ts-node-commonjs migration:run -d ./src/database/data-source.ts",
    "migration:revert": "npx typeorm-ts-node-commonjs migration:revert -d ./src/database/data-source.ts",
    "migration:generate": "npx typeorm-ts-node-commonjs migration:generate -d ./src/database/data-source.ts",
    "migration:check": "ts-node -r tsconfig-paths/register scripts/check-migrations.ts",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeds/seed.ts",
    "audit:prefixes": "ts-node -r tsconfig-paths/register scripts/audit/controller-prefix-audit.ts",
    "audit:controllers": "ts-node -r tsconfig-paths/register scripts/audit/controller-security-audit.ts",
    "audit:secrets": "ts-node -r tsconfig-paths/register scripts/audit/secret-scan.ts",
    "audit:circular": "ts-node -r tsconfig-paths/register scripts/audit/circular-dependency-audit.ts",
    "audit:security": "ts-node -r tsconfig-paths/register scripts/audit/security-audit.ts",
    "e2e:prepare": "ts-node -r tsconfig-paths/register scripts/ensure-e2e-database.ts",
    "test:e2e:business": "jest --config ./test/jest-e2e.json sales-to-cash.e2e-spec.ts --runInBand",
    "audit:migration-order": "ts-node -r tsconfig-paths/register scripts/audit-migration-order.ts",
    "migration:repair-history": "ts-node -r tsconfig-paths/register scripts/repair-migration-history.ts",
    "migration:run:safe": "npm run migration:repair-history && npm run audit:migration-order && npx typeorm-ts-node-commonjs migration:run -d ./src/database/data-source.ts",
    "audit:items-schema": "ts-node -r tsconfig-paths/register scripts/audit-items-schema.ts",
    "audit:sales-order-schema": "ts-node -r tsconfig-paths/register scripts/audit-sales-order-schema.ts",
    "test:e2e:procure": "jest --config ./test/jest-e2e.json procure-to-pay.e2e-spec.ts --runInBand",
    "audit:supplier-schema": "ts-node -r tsconfig-paths/register scripts/audit-supplier-schema.ts",
    "audit:purchase-invoice-schema": "ts-node -r tsconfig-paths/register scripts/audit-purchase-invoice-schema.ts",
    "audit:supplier-payment-schema": "ts-node -r tsconfig-paths/register scripts/audit-supplier-payment-schema.ts",
    "audit:entity-schema": "ts-node -r tsconfig-paths/register scripts/audit-entity-schema.ts",
    "audit:accounting-idempotency": "ts-node -r tsconfig-paths/register scripts/audit-accounting-idempotency.ts",
    "audit:returns-readiness": "ts-node -r tsconfig-paths/register scripts/audit-returns-readiness.ts",
    "test:e2e:commercial": "jest --config ./test/jest-e2e.json sales-to-cash.e2e-spec.ts procure-to-pay.e2e-spec.ts --runInBand",
    "audit:manufacturing": "ts-node -r tsconfig-paths/register scripts/audit-manufacturing-readiness.ts",
    "test:e2e:manufacturing": "jest --config ./test/jest-e2e.json manufacturing.e2e-spec.ts --runInBand",
    "audit:manufacturing:integrity": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-integrity-audit.ts",
"audit:manufacturing:routes": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-route-map.ts",
"audit:manufacturing:db": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-db-audit.ts",
"audit:manufacturing:contract": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-contract-report.ts",
"generate:e2e:manufacturing": "ts-node -r tsconfig-paths/register scripts/generate-manufacturing-e2e.ts",
"audit:manufacturing:release": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-release-gate.ts",
"audit:manufacturing:fixes": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-fix-analyzer.ts",
"release:readiness": "ts-node -r tsconfig-paths/register scripts/release/production-readiness-gate.ts",
"audit:manufacturing:accounting": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-accounting-readiness.ts",
"audit:manufacturing:posting-contract": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-posting-contract.ts",
"generate:manufacturing:posting-rules": "ts-node -r tsconfig-paths/register scripts/generate-manufacturing-posting-rules.ts",
"audit:manufacturing:autopost": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-autopost-readiness.ts",
"audit:manufacturing:lifecycle-autopost": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-lifecycle-autopost.ts",
"audit:manufacturing:accounting-e2e": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-accounting-e2e-readiness.ts",
"audit:manufacturing:accounting-e2e": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-accounting-e2e-readiness.ts",
"test:e2e:manufacturing-accounting": "jest --config ./test/jest-e2e.json manufacturing-accounting.e2e-spec.ts --runInBand",
"e2e:migrate": "ts-node -r tsconfig-paths/register scripts/e2e/run-e2e-migrations.ts",
"audit:manufacturing:schema-preflight": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-schema-preflight.ts",
"audit:manufacturing:e2e-bootstrap": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-accounting-e2e-bootstrap.ts",
"audit:manufacturing:lifecycle-methods": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-lifecycle-method-locator.ts",
"audit:production-completion:api": "ts-node -r tsconfig-paths/register scripts/audit/production-completion-api-readiness.ts",
"audit:manufacturing:e2e-bootstrap-v2": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-accounting-e2e-bootstrap-v2.ts",
"audit:manufacturing:e2e-contract": "ts-node -r tsconfig-paths/register scripts/audit/manufacturing-e2e-contract.ts",
"audit:manufacturing:e2e-fixture-contract": "ts-node -r tsconfig-paths/register scripts/e2e/manufacturing-e2e-fixture-contract.ts",
"audit:manufacturing:table-discovery": "ts-node -r tsconfig-paths/register scripts/e2e/manufacturing-table-discovery.ts",
"audit:manufacturing:engine-smoke": "ts-node -r tsconfig-paths/register scripts/e2e/manufacturing-accounting-engine-smoke.ts",
"test:e2e:manufacturing-core": "jest --config ./test/jest-e2e.json manufacturing-core-lifecycle.e2e-spec.ts --runInBand"

},
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
